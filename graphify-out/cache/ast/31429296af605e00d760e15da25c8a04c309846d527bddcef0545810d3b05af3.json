tupWizard.jsx", "source_location": "L415"}, {"caller_nid": "pages_tournamentsetupwizard_tournamentsetupwizard", "callee": "map", "is_member_call": true, "source_file": "/Users/santi/Documents/Arenix/arenix/src/pages/TournamentSetupWizard.jsx", "source_location": "L439"}, {"caller_nid": "pages_tournamentsetupwizard_tournamentsetupwizard", "callee": "(() => {\n              const allPlayerIds = (league.players || []).map(p => p.id)\n              const allSelected  = allPlayerIds.length > 0 && pickedPlayers.length === allPlayerIds.length\n              return (\n                <div className=\"flex items-center justify-between mb-3\">\n                  <div className=\"text-[11px] font-bold text-accent uppercase tracking-widest\">\n                    Players ({pickedPlayers.length} selected)\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      onClick={() => setShowAddPlayer(true)}\n                      className=\"w-[34px] h-[34px] rounded-[10px] bg-surface border border-line flex items-center justify-center text-dim cursor-pointer flex-shrink-0\"\n                    >\n                      <Plus size={16} />\n                    </button>\n                    <button\n                      onClick={() => setPickedPlayers(allSelected ? [] : allPlayerIds)}\n                      className=\"text-[11px] font-semibold text-accent bg-transparent border-0 cursor-pointer\"\n                    >\n                      {allSelected ? 'Deselect all' : 'Select all'}\n                    </button>\n                  </div>\n                </div>\n              )\n            })", "is_member_call": false, "source_file": "/Users/santi/Documents/Arenix/arenix/src/pages/TournamentSetupWizard.jsx", "source_location": "L465"}, {"caller_nid": "pages_tournamentsetupwizard_tournamentsetupwizard", "callee": "map", "is_member_call": true, "source_file": "/Users/santi/Documents/Arenix/arenix/src