s_livescoresection_livescoresection", "callee": "(() => {\n        const prev = history[history.length - 1];\n        const rot = serveRotation;\n        const prevServer = rot[prev.serveIndex % 4];\n        return (\n          <div className=\"fixed inset-0 z-[200] bg-black/65 flex items-center justify-center p-6\">\n            <div className=\"bg-surface rounded-3xl p-7 text-center max-w-[340px] w-full shadow-[0_24px_60px_rgba(0,0,0,0.3)]\">\n              <div className=\"text-[44px] mb-2\">\u21a9</div>\n              <div className=\"font-display text-[30px] text-error tracking-[2px] leading-tight\">\n                UNDO POINT\n              </div>\n              <div className=\"text-[14px] text-dim mt-3 mb-4\">\n                Confirm? Match returns to:\n              </div>\n              <div className=\"bg-alt rounded-[14px] px-4 py-3.5 mb-5\">\n                <div className=\"font-display text-[42px] text-text leading-none mb-2\">\n                  {prev.score1} \u2013 {prev.score2}\n                </div>\n                <div className=\"text-[13px] text-dim mb-1.5\">\n                  {tName(team1Id)} \u2013 {tName(team2Id)}\n                </div>\n                <div className=\"inline-block bg-accent/15 rounded-[8px] px-3.5 py-1.5\">\n                  <div className=\"text-[11px] text-accent font-bold uppercase\">\ud83c\udfd0 Was serving</div>\n                  <div className=\"text-[15px] font-bold text-text\">{playerName(prevServer.playerId)}</div>\n                  <div className=\"text-[12px] text-dim\">{tName(prevServer.team === 1 ? team1Id : team2Id)}</div>\n                </div>\n              </div>\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  onClick={cancelUndo}\n                  className=\"min-h-[44px] rounded-xl text-[14px] font-bold bg-alt text-dim border border-line cursor-pointer\"\n                >\n                  Cancel\n                </button>\n                <button\n                  onClick={confirmUndo}\n                  className=\"min-h-[44px] rounded-xl text-[14px] font-bold bg-error text-white border-0 cursor-pointer\"\n                >\n                  Confirm\n                </button>\n              </div>\n            </div>\n          </div>\n        );\n      })", "is_member_call": false, "source_file": "/Users/santi/Documents/Arenix/arenix/src/components/LiveScoreSection.jsx", "source_location": "L162"}, {"caller_nid": "components_livescoresection_livescoresection", "callee": "tName", "is_member_call": false, "source_file": "/Users/santi/Documents/Arenix/arenix/src/components/LiveScoreSection.jsx", "source_location": "L246"}, {"caller_nid": "components_livescoresection_livescoresection", "callee": "map", "is_member_call": true, "source_file": "/Users/santi/Documents/Arenix/arenix/src/components/LiveScoreSection.jsx", "source_location": "L254"}, {"caller_nid": "components_livescoresection_livescoresection", "callee": "filter", "is_member_call": true, "source_file": "/Users/santi/Documents/Arenix/arenix/src/components/LiveScoreSection.jsx", "source_location": "L254"}, {"caller_nid": "components_livescoresection_livescoresection", "callee": "tName", "is_member_call": false, "source_file": "/Users/santi/Documents/Arenix/arenix/src/components/LiveScoreSection.jsx", "source_location": "L295"}, {"caller_nid": "components_livescoresection_livescoresection", "callee": "map", "is_member_call": true, "source_file": "/Users/santi/Documents/Arenix/arenix/src/components/LiveScoreSection.jsx", "source_location": "L303"}, {"caller_nid": "components_livescoresection_livescoresection", "callee": "(() => {\n        const { teamNum, ptId } = pendingPlayerSelect;\n        const isError = ptId === \"error\";\n        const selectTeamNum = isError ? (teamNum === 1 ? 2 : 1) : teamNum;\n        const selectTeamId  = selectTeamNum === 1 ? team1Id : team2Id;\n        const selectOrder   = selectTeamNum === 1 ? t1ServeOrder : t2ServeOrder;\n        const isTeam1Color  = selectTeamNum === 1;\n        return (\n          <div className=\"fixed inset-0 z-[200] bg-black/60 flex items-end justify-center\">\n            <div className=\"bg-bg rounded-t-[24px] px-5 pt-4 pb-9 w-full max-w-[480px] shadow-[0_-12px_40px_rgba(0,0,0,0.25)]\">\n              <div className=\"w-9 h-1 bg-alt rounded-full mx-auto mb-3.5\" />\n              <div className=\"text-center mb-4\">\n                <div className={`inline-block rounded-[10px] px-4 py-1.5 ${isTeam1Color ? \"bg-accent/15\" : \"bg-free/15\"}`}>\n                  <div className=\"text-[11px] text-dim uppercase tracking-wide\">\n                    {isError ? \"Rival error\" : \"Point for\"}\n                  </div>\n                  <div className={`font-display text-[22px] tracking-wide ${isTeam1Color ? \"text-accent\" : \"text-free\"}`}>\n                    {tName(selectTeamId)}\n                  </div>\n                </div>\n              </div>\n              <div className=\"font-display text-[18px] text-text tracking-wide mb-3.5 text-center\">\n                {isError ? \"WHO MADE THE ERROR?\" : \"WHO SCORED?\"}\n              </div>\n              <div className=\"grid grid-cols-2 gap-2.5 mb-3\">\n                {selectOrder.map(pid => (\n                  <button\n                    key={pid}\n                    onClick={() => confirmPlayer(pid)}\n                    className=\"bg-alt border-2 border-line rounded-[14px] px-2.5 py-4 cursor-pointer text-center\"\n                  >\n                    <div className=\"font-bold text-[15px] text-text\">{playerName(pid)}</div>\n                  </button>\n                ))}\n              </div>\n              <button\n                onClick={() => confirmPlayer(null)}\n                className=\"w-full bg-transparent border-2 border-line rounded-[14px] py-3 cursor-pointer text-dim text-[14px]\"\n              >\n                Skip\n              </button>\n            </div>\n          </div>\n        );\n      })", "is_member_call": false, "source_file": "/Users/santi/Documents/Arenix/arenix/src/components/LiveScoreSection.jsx", "source_location": "L326"}, {"caller_nid": "components_livescoresection_livescoresection", "callee": "tName", "is_member_call": false, "source_file": "/Users/santi/Documents/Arenix/arenix/src/components/LiveScoreSection.jsx", "source_location": "L380"}, {"caller_nid": "components_livescoresection_livescoresection", "callee": "tName", "is_member_call": false, "source_file": "/Users/santi/Documents/Arenix/arenix/src/components/LiveScoreSection.jsx", "source_location": "L380"}, {"caller_nid": "components_livescoresection_livescoresection", "callee": "map", "is_member_call": true, "source_file": "/Users/santi/Documents/Arenix/arenix/src/components/LiveScoreSection.jsx", "source_location": "L387"}]}